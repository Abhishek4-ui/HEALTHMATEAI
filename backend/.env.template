# =====================================================================
# HealthMate AI - Backend Environment Configuration (.env)
# Place your real credentials here. This file is gitignored.
# =====================================================================

NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# A. MongoDB Atlas (Persistent Database)
# ---------------------------------------------------------------------
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthmate_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/healthmate_ai

# ---------------------------------------------------------------------
# B. Redis Cloud (Ephemeral Cache, TTL Sessions & Forget-Me Purge)
# ---------------------------------------------------------------------
# Example: redis://default:<password>@<redis-endpoint>:6379
REDIS_URL=redis://localhost:6379
REDIS_GUEST_TTL=3600
REDIS_REPORT_TTL=1800
REDIS_GEO_TTL=7200

# ---------------------------------------------------------------------
# C. Email OTP Provider (Resend / SendGrid / SMTP)
# ---------------------------------------------------------------------
# For direct SMTP (e.g., Gmail App Password or SendGrid):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Or API Key:
EMAIL_API_KEY=

# ---------------------------------------------------------------------
# D. SMS OTP Provider (Twilio / Fast2SMS)
# ---------------------------------------------------------------------
SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------
# E. OpenRouter Primary LLM Gateway
# ---------------------------------------------------------------------
LLM_PRIMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=anthropic/claude-3.5-sonnet

# ---------------------------------------------------------------------
# F. Google Gemini Fallback LLM Gateway
# ---------------------------------------------------------------------
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------
# G. Google Maps Platform (Places API New, Geocoding)
# ---------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_REGION=in

# ---------------------------------------------------------------------
# H. Private Medical File Storage (AWS S3)
# ---------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------
# I. Razorpay Payments (India UPI, Cards, Netbanking)
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# J. Approved Healthcare Integrations (ABDM Sandbox)
# ---------------------------------------------------------------------
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ---------------------------------------------------------------------
# Cryptographic Keys (Auto-generated or override for production)
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_prod_min64chars!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_prod_min64chars!
INTERNAL_SERVICE_SECRET=dev_internal_hmac_secret_key_12345
