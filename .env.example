# =====================================================================
# HealthMate AI - Master Environment Configuration Template
# =====================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Persistent Database (MongoDB Atlas)
# In production, use MongoDB Atlas AWS Mumbai (ap-south-1) connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthmate_ai?retryWrites=true&w=majority

# Ephemeral Cache & Session Storage (Redis Cloud)
# In production, use Redis Cloud managed instance with TTL-based expiration
REDIS_URL=redis://default:<password>@redis-cloud-endpoint:6379

# Cryptography & JWT Security
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_64_characters_long_for_security
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_64_characters_long_for_security
INTERNAL_SERVICE_SECRET=your_internal_service_hmac_sha256_shared_secret_between_node_and_fastapi

# LLM Gateway: OpenRouter (Primary) + Google Gemini (Fallback)
LLM_PRIMARY_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL_NAME=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2

# Geolocation & Discovery APIs
GOOGLE_PLACES_API_KEY=AIzaSy_your_google_places_api_key_here
GOOGLE_MAPS_REGION=in

# Telemedicine WebRTC Infrastructure (STUN/TURN)
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Ephemeral Object Storage (AWS S3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=healthmate-ephemeral-uploads
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ABDM Sandbox (National Health Authority)
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=SBX_your_abdm_client_id
ABDM_CLIENT_SECRET=your_abdm_client_secret
